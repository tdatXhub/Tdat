    TextSub.TextSize = 9
    TextSub.TextXAlignment = Enum.TextXAlignment.Left
    TextSub.Parent = ToggleRow

    local Switch = Instance.new("TextButton")
    Switch.Size = UDim2.new(0, 36, 0, 18)
    Switch.Position = UDim2.new(1, -42, 0.5, -9)
    Switch.BackgroundColor3 = default and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(40, 30, 60)
