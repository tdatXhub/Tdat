    Knob.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Parent = Switch
    AddCorner(Knob, 8)

    local state = default
    Switch.MouseButton1Click:Connect(function()
        state = not state
        Tween(Switch, 0.2, {BackgroundColor3 = state and Color3.fromRGB(138, 43, 226) or Color3.fromRGB(40, 30, 60)})
        Tween(Knob, 0.2, {Position = state and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)})
        if callback then callback(state) end
    end)
end

local function CreateSlider(parent, title, min, max, default, callback)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Size = UDim2.new(1, 0, 0, 42)
    SliderFrame.BackgroundColor3 = Color3.fromRGB(22, 14, 42)
    SliderFrame.Parent = parent
    AddCorner(SliderFrame, 6)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Size = UDim2.new(0.6, 0, 0, 18)
    TitleLabel.Position = UDim2.new(0, 8, 0, 3)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Text = title
    TitleLabel.TextColor3 = Color3.fromRGB(230, 220, 255)
    TitleLabel.Font = Enum.Font.GothamMedium
    TitleLabel.TextSize = 11
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.Parent = SliderFrame

    local ValueBox = Instance.new("TextLabel")
    ValueBox.Size = UDim2.new(0, 32, 0, 16)
    ValueBox.Position = UDim2.new(1, -40, 0, 3)
    ValueBox.BackgroundColor3 = Color3.fromRGB(35, 22, 65)
    ValueBox.Text = tostring(default)
    ValueBox.TextColor3 = Color3.fromRGB(210, 170, 255)
    ValueBox.Font = Enum.Font.GothamBold
    ValueBox.TextSize = 10
    ValueBox.Parent = SliderFrame
    AddCorner(ValueBox, 4)

    local Track = Instance.new("Frame")
    Track.Size = UDim2.new(1, -16, 0, 5)
    Track.Position = UDim2.new(0, 8, 0, 26)
    Track.BackgroundColor3 = Color3.fromRGB(40, 30, 60)
    Track.Parent = SliderFrame
    AddCorner(Track, 3)

    local Fill = Instance.new("Frame")
    Fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(157, 78, 221)
    Fill.Parent = Track
    AddCorner(Fill, 3)

    local dragging = false
    SliderFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local percent = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            local val = math.floor(min + (max - min) * percent)
            ValueBox.Text = tostring(val)
            Fill.Size = UDim2.new(percent, 0, 1, 0)
            if callback then callback(val) end
        end
    end)
end

