    TextMain.Font = Enum.Font.GothamMedium
    TextMain.TextSize = 11
    TextMain.TextXAlignment = Enum.TextXAlignment.Left
    TextMain.Parent = ToggleRow

    local TextSub = Instance.new("TextLabel")
    TextSub.Size = UDim2.new(0.7, 0, 0, 12)
    TextSub.Position = UDim2.new(0, 8, 0, 18)
    TextSub.BackgroundTransparency = 1
